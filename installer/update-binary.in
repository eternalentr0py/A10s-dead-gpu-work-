#!/sbin/sh
# softgfx TWRP installer/uninstaller  (MODE=@MODE@)   build: @VERSION@
# Installs the software EGL/GLES stack into /vendor/lib/egl and points ro.hardware.egl at it.
# Backs up what it changes to /cache/softgfx_backup so the uninstaller can restore it.
OUTFD=$2
ZIPFILE=$3
MODE=@MODE@
V="${SOFTGFX_VENDOR:-/vendor}"
BK="${SOFTGFX_BACKUP:-/cache/softgfx_backup}"
W="${SOFTGFX_WORK:-/tmp/softgfx_inst}"
LIBDIR="$V/lib/egl"
FILES="libEGL_soft.so libEGL_mesa_real.so libGLESv1_CM_soft.so libGLESv2_soft.so libglapi_soft.so libdrm_soft.so swrast_dri.so"
OPENGLES_VER=196609          # GLES 3.1 (what Mesa softpipe provides); stock value is 196610 (3.2)

# hwcomposer.mt6765.so pulls in libged.so (PowerVR's GPU governor) and libgralloc_extra.so
# (PVR-aware buffer metadata) - both still hit the dead GPU even for a plain framebuffer
# composite. The composer service (android.hardware.graphics.composer@2.1-service) already
# links libhwc2onfbadapter.so, so removing the MTK module lets it fall back to fb0 client
# composition with no GPU involvement. Backed up/restored the same way as the EGL libs.
HWC_DIR="$V/lib/hw"
HWC_FILE="hwcomposer.mt6765.so"

# vendor.mediatek.hardware.gpu@1.0-service ("gpu-1-0" in init) is MTK's GPU-info/governor HIDL
# service - confirmed from an actual device dump (vendor/etc/init/vendor.mediatek.hardware.gpu@1.0-service.rc)
# to be a plain "class hal" autostart service with no listed dependents, so disabling it should
# be safe; it still talks to the dead GPU (same libged path as hwcomposer did) for no boot-
# critical reason. The allocator (vendor.gralloc-4-0) and composer (vendor.hwcomposer-2-1)
# services are both confirmed required by the vendor vintf manifest and are left alone; they
# still run, just without the PVR-touching HWC module alongside them.
GPU_SVC_RC="$V/etc/init/vendor.mediatek.hardware.gpu@1.0-service.rc"

ui_print() {
  if [ -n "$OUTFD" ] && [ -e "/proc/self/fd/$OUTFD" ]; then
    echo "ui_print $1" > "/proc/self/fd/$OUTFD"; echo "ui_print" > "/proc/self/fd/$OUTFD"
  else
    echo "$1"
  fi
}
die() { ui_print " "; ui_print "ERROR: $1"; ui_print "Nothing further was changed."; exit 1; }

ui_print "=============================================="
ui_print " A10s software graphics ($MODE)"
ui_print " @VERSION@"
ui_print "=============================================="

# ---- mount /vendor read-write ----
if [ -z "$SOFTGFX_TEST" ]; then
  if ! grep -q " $V " /proc/mounts 2>/dev/null; then
    mkdir -p "$V"
    for d in /dev/block/platform/bootdevice/by-name/vendor /dev/block/by-name/vendor /dev/block/mmcblk0p33; do
      if [ -e "$d" ]; then mount -t ext4 -o rw "$d" "$V" 2>/dev/null && break; fi
    done
  fi
  mount -o remount,rw "$V" 2>/dev/null
  mkdir -p /cache 2>/dev/null
  grep -q " /cache " /proc/mounts 2>/dev/null || mount -t ext4 -o rw /dev/block/platform/bootdevice/by-name/cache /cache 2>/dev/null || mount -t ext4 -o rw /dev/block/mmcblk0p37 /cache 2>/dev/null
fi
[ -d "$V/lib" ] || die "/vendor is not mounted (no $V/lib)."
touch "$V/.softgfx_w" 2>/dev/null && rm -f "$V/.softgfx_w" || die "/vendor is read-only."
[ -f "$V/build.prop" ] || die "$V/build.prop not found."
mkdir -p "$BK" 2>/dev/null || die "cannot create backup folder $BK (is /cache mounted?)."

setprop_file() {   # $1=file $2=key $3=value   (replace the line if present, else append)
  f="$1"; k="$2"; v="$3"
  if grep -q "^$k=" "$f"; then
    sed -i "s|^$k=.*|$k=$v|" "$f"
  else
    [ -n "$(tail -c1 "$f" 2>/dev/null)" ] && echo >> "$f"
    echo "$k=$v" >> "$f"
  fi
}

label() {  # best effort SELinux label (new files normally inherit the folder's label anyway)
  for c in "chcon" "toybox chcon" "busybox chcon"; do
    $c u:object_r:same_process_hal_file:s0 "$1" 2>/dev/null && return 0
  done
  return 1
}

if [ "$MODE" = "install" ]; then
  rm -rf "$W"; mkdir -p "$W"
  ui_print "- extracting"
  # extract everything (TWRP's unzip does not expand wildcards), then locate the files by search
  unzip -o "$ZIPFILE" -d "$W" >/dev/null 2>&1 || busybox unzip -o "$ZIPFILE" -d "$W" >/dev/null 2>&1 || die "cannot extract the zip."
  FOUND=$(find "$W" -name libEGL_soft.so 2>/dev/null | head -n 1)
  if [ -z "$FOUND" ]; then
    ui_print "  extracted layout:"; find "$W" -type f 2>/dev/null | head -n 20 | while read -r l; do ui_print "   $l"; done
    die "libEGL_soft.so not found after extracting the zip."
  fi
  SRC=$(dirname "$FOUND")
  for f in $FILES; do [ -f "$SRC/$f" ] || die "zip is missing $f"; done

  need=$(du -sk "$SRC" | cut -f1)
  avail=$(df -k "$V" | awk 'NR>1{a=$(NF-2)} END{print a}')
  ui_print "- /vendor free space: ${avail:-?} KB, needed: $need KB"
  if [ -n "$avail" ] && [ "$avail" -lt $((need + 1024)) ] 2>/dev/null; then
    die "not enough free space on /vendor."
  fi

  ui_print "- backing up to $BK"
  [ -f "$BK/build.prop.orig" ] || cp -p "$V/build.prop" "$BK/build.prop.orig"
  ( cd "$LIBDIR" 2>/dev/null && ls $FILES 2>/dev/null ) > "$BK/pre-existing.txt"   # files that already existed (should be empty)

  ui_print "- installing libraries to $LIBDIR"
  mkdir -p "$LIBDIR"
  for f in $FILES; do
    cp "$SRC/$f" "$LIBDIR/$f" || die "copy of $f failed."
    chmod 644 "$LIBDIR/$f"; chown 0:0 "$LIBDIR/$f" 2>/dev/null
    label "$LIBDIR/$f" || SELABEL_FAIL=1
  done
  [ -n "$SELABEL_FAIL" ] && ui_print "  (note: could not set SELinux label explicitly; relying on the folder's label)"

  ui_print "- updating $V/build.prop"
  setprop_file "$V/build.prop" ro.hardware.egl soft
  setprop_file "$V/build.prop" ro.opengles.version "$OPENGLES_VER"
  # Best-effort: this device already ships a gralloc.default.so (AOSP's CPU/ashmem fallback)
  # next to gralloc.rogue.so (the real PVR-backed one). If the allocator service respects
  # ro.hardware.gralloc the way ro.hardware.egl is respected, this alone may route buffer
  # allocation away from the dead GPU. Harmless if it's ignored - MediaTek's allocator@4.0
  # service is statically linked to libPVRMtkutils.so either way, so this is not confirmed
  # to be sufficient; see docs/ARCHITECTURE.md component #3, still open.
  if [ -f "$V/lib/hw/gralloc.default.so" ]; then
    setprop_file "$V/build.prop" ro.hardware.gralloc default
    ui_print "  $(grep '^ro.hardware.gralloc=' "$V/build.prop")  (best-effort, unconfirmed - gralloc.default.so exists on this device)"
  fi
  ui_print "  $(grep '^ro.hardware.egl=' "$V/build.prop")"
  ui_print "  $(grep '^ro.opengles.version=' "$V/build.prop")"

  ui_print "- disabling $HWC_FILE (falls back to libhwc2onfbadapter)"
  if [ -f "$HWC_DIR/$HWC_FILE" ]; then
    [ -f "$BK/$HWC_FILE" ] || cp -p "$HWC_DIR/$HWC_FILE" "$BK/$HWC_FILE"
    mv "$HWC_DIR/$HWC_FILE" "$HWC_DIR/$HWC_FILE.softgfx_disabled"
    ui_print "  moved to $HWC_DIR/$HWC_FILE.softgfx_disabled"
  else
    ui_print "  not found at $HWC_DIR/$HWC_FILE (already disabled, or different path - check manually)"
  fi

  ui_print "- disabling vendor.mediatek.hardware.gpu@1.0-service (gpu-1-0)"
  if [ -f "$GPU_SVC_RC" ]; then
    if grep -q "^[[:space:]]*disabled" "$GPU_SVC_RC"; then
      ui_print "  already disabled"
    else
      [ -f "$BK/vendor.mediatek.hardware.gpu@1.0-service.rc" ] || cp -p "$GPU_SVC_RC" "$BK/vendor.mediatek.hardware.gpu@1.0-service.rc"
      printf '%s\n' "    disabled" >> "$GPU_SVC_RC"
      ui_print "  added 'disabled' to $GPU_SVC_RC"
    fi
  else
    ui_print "  not found at $GPU_SVC_RC (path may differ on this build - check manually)"
  fi

  ui_print "- installing boot checkpoints (fb0 markers at boot milestones - see legend below)"
  CKBIN=$(find "$W" -name softgfx_checkpoint 2>/dev/null | head -n 1)
  CKRC=$(find "$W" -name softgfx_checkpoints.rc 2>/dev/null | head -n 1)
  if [ -n "$CKBIN" ] && [ -n "$CKRC" ]; then
    mkdir -p "$V/bin" "$V/etc/init"
    cp "$CKBIN" "$V/bin/softgfx_checkpoint" && chmod 755 "$V/bin/softgfx_checkpoint"
    cp "$CKRC" "$V/etc/init/softgfx_checkpoints.rc" && chmod 644 "$V/etc/init/softgfx_checkpoints.rc"
    ui_print "  installed. On the NEXT boot attempt, watch the top-left corner of the screen:"
    ui_print "  1=red(init alive) 2=orange(post-fs-data) 3=yellow(zygote-start) 4=green(gralloc svc up)"
    ui_print "  5=cyan(composer svc up) 6=blue(surfaceflinger up) 7=purple(zygote up) 8=white(boot_completed)"
    ui_print "  Whichever box is the LAST one lit tells us where it's getting stuck."
  else
    ui_print "  SKIPPED (softgfx_checkpoint/.rc not found in the zip)"
  fi

  echo "$FILES" > "$BK/installed-files.txt"
  sync

  ui_print " "
  ui_print "- live test: rendering with the installed EGL/GLES and blitting to the screen"
  TESTBIN="$W/bin/fbdev_test"
  TRES="/tmp/softgfx_livetest.txt"
  rm -f "$TRES"

  # libEGL_soft.so needs libnativewindow.so (a normal platform lib, always present on a real
  # boot) which lives under /system - TWRP does not mount /system by default. Try to mount it
  # read-only now so the live test's dlopen() can actually find it; this does not affect the
  # real boot path at all, where /system is always mounted by then.
  for sp in /system_root /system; do mkdir -p "$sp" 2>/dev/null; done
  if ! grep -q " /system_root " /proc/mounts 2>/dev/null && ! grep -q " /system " /proc/mounts 2>/dev/null; then
    for d in /dev/block/platform/bootdevice/by-name/system /dev/block/by-name/system /dev/block/mmcblk0p35; do
      [ -e "$d" ] && mount -t ext4 -o ro "$d" /system_root 2>/dev/null && break
      [ -e "$d" ] && mount -t ext4 -o ro "$d" /system 2>/dev/null && break
    done
  fi
  NW_PATH=""
  for p in /system_root/system/lib /system/lib "$V/lib"; do
    [ -f "$p/libnativewindow.so" ] && NW_PATH="$p" && break
  done
  [ -z "$NW_PATH" ] && ui_print "  (note: libnativewindow.so not found under /system or /vendor/lib - mount System in TWRP's Mount menu and re-run the live test manually if this fails)"

  if [ -x "$TESTBIN" ]; then
    FB=""
    for d in /dev/graphics/fb0 /dev/fb0; do [ -e "$d" ] && FB="$d" && break; done
    if [ -z "$FB" ]; then
      ui_print "  SKIPPED (no /dev/graphics/fb0 or /dev/fb0 found on this device)"
    else
      env LD_LIBRARY_PATH="$LIBDIR:$NW_PATH:/system_root/system/lib:/system/lib:$V/lib" \
          LIBGL_DRIVERS_PATH="$LIBDIR" LIBGL_ALWAYS_SOFTWARE=1 GALLIUM_DRIVER=softpipe \
          "$TESTBIN" "$LIBDIR/libEGL_soft.so" "$LIBDIR/libGLESv2_soft.so" "$FB" > "$TRES" 2>&1
      TRC=$?
      # show the short verdict line plus whatever got flagged FAIL, in the TWRP log
      grep -E "^RESULT:|FAIL" "$TRES" | while read -r l; do ui_print "  $l"; done
      if [ "$TRC" = "0" ]; then
        ui_print "  LIVE TEST: PASS (exit=$TRC)"
        ui_print "  Look at the screen now: a magenta border + a shaded triangle means it rendered."
      else
        ui_print "  LIVE TEST: FAIL (exit=$TRC) - see $TRES for details. Install is still in place;"
        ui_print "  this does not undo anything, but the software stack likely isn't fully working."
      fi
      sleep 4
    fi
  else
    ui_print "  SKIPPED (fbdev_test binary not found in the zip at bin/fbdev_test)"
  fi

  ui_print " "
  ui_print "Done. Reboot to system."
  ui_print "To undo: flash softgfx-uninstaller.zip"
else
  ui_print "- removing libraries"
  for f in $FILES; do rm -f "$LIBDIR/$f"; done

  ui_print "- removing boot checkpoints"
  rm -f "$V/bin/softgfx_checkpoint" "$V/etc/init/softgfx_checkpoints.rc"

  ui_print "- restoring vendor.mediatek.hardware.gpu@1.0-service"
  if [ -f "$BK/vendor.mediatek.hardware.gpu@1.0-service.rc" ]; then
    cp -p "$BK/vendor.mediatek.hardware.gpu@1.0-service.rc" "$GPU_SVC_RC" && ui_print "  restored $GPU_SVC_RC"
  else
    ui_print "  no backup found; leaving it as is"
  fi

  ui_print "- restoring $HWC_FILE"
  if [ -f "$HWC_DIR/$HWC_FILE.softgfx_disabled" ]; then
    mv "$HWC_DIR/$HWC_FILE.softgfx_disabled" "$HWC_DIR/$HWC_FILE"
    ui_print "  restored from the renamed copy"
  elif [ -f "$BK/$HWC_FILE" ]; then
    cp -p "$BK/$HWC_FILE" "$HWC_DIR/$HWC_FILE"
    ui_print "  restored from $BK/$HWC_FILE"
  else
    ui_print "  no disabled/backed-up copy found; leaving $HWC_DIR as is"
  fi

  if [ -f "$BK/build.prop.orig" ]; then
    cp "$BK/build.prop.orig" "$V/build.prop" && ui_print "- restored original build.prop"
  else
    ui_print "- no backup of build.prop found; leaving it as is (check ro.hardware.egl / ro.hardware.gralloc)"
  fi
  sync
  ui_print "Done. Stock libraries untouched."
fi
exit 0
